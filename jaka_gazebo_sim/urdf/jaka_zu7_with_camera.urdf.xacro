<?xml version="1.0"?>
<!--
  JAKA ZU7 with Eye-in-Hand Camera for Gazebo Simulation

  Usage:
    xacro jaka_zu7_with_camera.urdf.xacro use_gazebo:=true > robot.urdf
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jaka_zu7">
    <xacro:arg name="use_gazebo" default="false"/>

    <!-- Import jaka_zu7 urdf file -->
    <xacro:include filename="$(find jaka_description)/urdf/jaka_zu7.urdf" />

    <!-- Import camera xacro -->
    <xacro:include filename="$(find jaka_gazebo_sim)/urdf/inc/camera.urdf.xacro" />

    <!-- Add camera to end-effector (Link_6) -->
    <xacro:jaka_camera_gazebo parent="Link_6" />

    <!-- Gazebo-specific settings when use_gazebo:=true -->
    <!-- Note: ros2_control is configured in the world file, not here -->

</robot>
