<?xml version="1.0"?>
<!--
  JAKA ZU7 with Eye-in-Hand Camera - SDF World

  Key: Robot is loaded INLINE with the world, not dynamically spawned.
  This ensures camera sensor is properly registered by sensors-system.

  Robot base: Z=0.0 (ground level)
-->
<sdf version="1.7">
  <world name="jaka_zu7_eye_in_hand">

    <!-- Physics settings -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Camera sensor system -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Scene -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <grid>true</grid>
      <shadows>true</shadows>
    </scene>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- JAKA ZU7 Robot with Eye-in-Hand Camera - INLINE -->
    <model name="jaka_zu7">
      <!-- Robot base lifted so mesh sits on ground (mesh bottom at z=0) -->
      <pose>0 0 0.06 0 0 0</pose>

      <!-- Link 0: Base -->
      <link name="Link_0">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0.000964 0 0.019555 0 0 0</pose>
          <mass>4.0392</mass>
          <inertia>
            <ixx>0.0048763</ixx>
            <ixy>-1.8056e-07</ixy>
            <ixz>2.5196e-05</ixz>
            <iyy>0.0068003</iyy>
            <iyz>-1.7678e-09</iyz>
            <izz>0.010618</izz>
          </inertia>
        </inertial>
        <collision name="Link_0_collision">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_0.STL</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="Link_0_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_0.STL</uri>
            </mesh>
          </geometry>
        </visual>
      </link>

      <!-- Joint 1 -->
      <joint name="joint_1" type="revolute">
        <pose>0 0 0.12015 0 0 0</pose>
        <parent>Link_0</parent>
        <child>Link_1</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-6.28</lower>
            <upper>6.28</upper>
            <effort>2000</effort>
            <velocity>3.14</velocity>
          </limit>
        </axis>
      </joint>

      <!-- Link 1 -->
      <link name="Link_1">
        <inertial>
          <pose>-0 0.003323 -0.001509 0 0 0</pose>
          <mass>15.135</mass>
          <inertia>
            <ixx>0.044302</ixx>
            <ixy>1.5349e-07</ixy>
            <ixz>-6.1966e-07</ixz>
            <iyy>0.043091</iyy>
            <iyz>1.4326e-05</iyz>
            <izz>0.030523</izz>
          </inertia>
        </inertial>
        <collision name="Link_1_collision">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_1.STL</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="Link_1_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_1.STL</uri>
            </mesh>
          </geometry>
        </visual>
      </link>

      <!-- Joint 2 -->
      <joint name="joint_2" type="revolute">
        <pose>0 0 0 1.5708 0 0</pose>
        <parent>Link_1</parent>
        <child>Link_2</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.48</lower>
            <upper>4.62</upper>
            <effort>1500</effort>
            <velocity>3.14</velocity>
          </limit>
        </axis>
      </joint>

      <!-- Link 2 -->
      <link name="Link_2">
        <inertial>
          <pose>0.18 0 -0.14308 0 0 0</pose>
          <mass>42.872</mass>
          <inertia>
            <ixx>0.1014</ixx>
            <ixy>-1.1106e-06</ixy>
            <ixz>-1.3363e-07</ixz>
            <iyy>1.1119</iyy>
            <iyz>2.9045e-08</iyz>
            <izz>1.0844</izz>
          </inertia>
        </inertial>
        <collision name="Link_2_collision">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_2.STL</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="Link_2_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_2.STL</uri>
            </mesh>
          </geometry>
        </visual>
      </link>

      <!-- Joint 3 -->
      <joint name="joint_3" type="revolute">
        <pose>0.36 0 0 0 0 0</pose>
        <parent>Link_2</parent>
        <child>Link_3</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-3.05</lower>
            <upper>3.05</upper>
            <effort>1500</effort>
            <velocity>3.14</velocity>
          </limit>
        </axis>
      </joint>

      <!-- Link 3 -->
      <link name="Link_3">
        <inertial>
          <pose>0.15515 0 -0.012576 0 0 0</pose>
          <mass>16.562</mass>
          <inertia>
            <ixx>0.020968</ixx>
            <ixy>-3.9001e-06</ixy>
            <ixz>-0.018394</ixz>
            <iyy>0.28365</iyy>
            <iyz>-1.2859e-07</iyz>
            <izz>0.27848</izz>
          </inertia>
        </inertial>
        <collision name="Link_3_collision">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_3.STL</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="Link_3_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_3.STL</uri>
            </mesh>
          </geometry>
        </visual>
      </link>

      <!-- Joint 4 -->
      <joint name="joint_4" type="revolute">
        <pose>0.30353 0 -0.11501 0 0 0</pose>
        <parent>Link_3</parent>
        <child>Link_4</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.48</lower>
            <upper>4.62</upper>
            <effort>1000</effort>
            <velocity>3.14</velocity>
          </limit>
        </axis>
      </joint>

      <!-- Link 4 -->
      <link name="Link_4">
        <inertial>
          <pose>-2e-06 -0.0058 0.002672 0 0 0</pose>
          <mass>5.5525</mass>
          <inertia>
            <ixx>0.0092564</ixx>
            <ixy>1.1341e-07</ixy>
            <ixz>-1.2578e-08</ixz>
            <iyy>0.0052251</iyy>
            <iyz>-8.3499e-05</iyz>
            <izz>0.0089683</izz>
          </inertia>
        </inertial>
        <collision name="Link_4_collision">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_4.STL</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="Link_4_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_4.STL</uri>
            </mesh>
          </geometry>
        </visual>
      </link>

      <!-- Joint 5 -->
      <joint name="joint_5" type="revolute">
        <pose>0 -0.1135 0 1.5708 0 0</pose>
        <parent>Link_4</parent>
        <child>Link_5</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-6.28</lower>
            <upper>6.28</upper>
            <effort>1000</effort>
            <velocity>3.14</velocity>
          </limit>
        </axis>
      </joint>

      <!-- Link 5 -->
      <link name="Link_5">
        <inertial>
          <pose>-2e-06 -0.002889 -0.002342 0 0 0</pose>
          <mass>6.3339</mass>
          <inertia>
            <ixx>0.012993</ixx>
            <ixy>-1.0764e-07</ixy>
            <ixz>5.8559e-09</ixz>
            <iyy>0.0058454</iyy>
            <iyz>4.5426e-05</iyz>
            <izz>0.0127</izz>
          </inertia>
        </inertial>
        <collision name="Link_5_collision">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_5.STL</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="Link_5_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_5.STL</uri>
            </mesh>
          </geometry>
        </visual>
      </link>

      <!-- Joint 6 -->
      <joint name="joint_6" type="revolute">
        <pose>0 0.107 0 -1.5708 0 0</pose>
        <parent>Link_5</parent>
        <child>Link_6</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-6.28</lower>
            <upper>6.28</upper>
            <effort>1000</effort>
            <velocity>3.14</velocity>
          </limit>
        </axis>
      </joint>

      <!-- Link 6: End Effector -->
      <link name="Link_6">
        <inertial>
          <pose>2.7e-05 -1.3e-05 -0.020746 0 0 0</pose>
          <mass>1.4269</mass>
          <inertia>
            <ixx>0.000769933</ixx>
            <ixy>-6.97776e-07</ixy>
            <ixz>-6.18237e-07</ixz>
            <iyy>0.000775153</iyy>
            <iyz>8.2118e-07</iyz>
            <izz>0.0011347</izz>
          </inertia>
        </inertial>
        <collision name="Link_6_collision">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_6.STL</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="Link_6_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>/home/xiang/ros2-jaka-zu7/install/jaka_description/share/jaka_description/meshes/jaka_zu7_meshes/Link_6.STL</uri>
            </mesh>
          </geometry>
        </visual>
        <!-- EYE-IN-HAND CAMERA SENSOR -->
        <!-- Camera points forward (+X in optical frame) to look at workspace -->
        <sensor name="camera_sensor" type="camera">
          <pose>0 0 0.05 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>10</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>
          <topic>/camera/image_raw</topic>
        </sensor>
      </link>

      <!-- Robot can move -->
      <static>false</static>

      <!-- ros2_control plugin -->
      <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
        <parameters>/home/xiang/ros2-jaka-zu7/install/jaka_zu7_moveit_config/share/jaka_zu7_moveit_config/config/ros2_controllers.yaml</parameters>
        <robotNamespace>/</robotNamespace>
      </plugin>

    </model>

  </world>
</sdf>
