<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jaka_gazebo_sim</name>
  <version>0.0.0</version>
  <description>JAKA ZU7 Gazebo simulation with eye-in-hand camera</description>
  <maintainer email="1510311910@qq.com">xiang</maintainer>
  <license>Apache-2.0</license>

  <!-- ROS2 dependencies -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Gazebo dependencies -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>

  <!-- ROS2 bridge dependencies -->
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- Launch dependencies -->
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
