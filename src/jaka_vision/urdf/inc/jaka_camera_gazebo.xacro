<?xml version="1.0"?>
<!--
  JAKA ZU7 Eye-in-Hand Camera Configuration for Gazebo Sim (Fortress)

  Usage in robot URDF xacro:
    <xacro:include filename="$(find jaka_vision)/urdf/inc/jaka_camera_gazebo.xacro" />
    <xacro:jaka_camera_gazebo parent="Link_6" />
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro"
       xmlns:gazebo="http://gazebosim.org">

    <xacro:macro name="jaka_camera_gazebo" params="parent">

        <!-- Camera optical frame link -->
        <link name="camera_link_optical">
        </link>

        <!-- Camera physical link -->
        <link name="camera_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.01" />
                <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.02 0.02 0.02" />
                </geometry>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1.0" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.02 0.02 0.02" />
                </geometry>
            </collision>
        </link>

        <!-- Fixed joint to parent (end-effector) -->
        <joint name="camera_joint" type="fixed">
            <origin xyz="0.0 0.0 0.05" rpy="0 0 0" />
            <parent link="${parent}" />
            <child link="camera_link" />
        </joint>

        <!-- Optical frame joint for ROS convention -->
        <joint name="camera_optical_joint" type="fixed">
            <origin xyz="0.0 0.0 0.0" rpy="-1.5707 0 -1.5707"/>
            <parent link="camera_link"/>
            <child link="camera_link_optical"/>
        </joint>

        <!-- Gazebo sensor configuration -->
        <gazebo reference="camera_link">
            <sensor name="camera_sensor" type="camera">
                <always_on>true</always_on>
                <update_rate>30.0</update_rate>
                <visualize>true</visualize>
                <camera>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>10.0</far>
                    </clip>
                </camera>
                <topic>/camera/image_raw</topic>
            </sensor>
        </gazebo>

    </xacro:macro>

</robot>
