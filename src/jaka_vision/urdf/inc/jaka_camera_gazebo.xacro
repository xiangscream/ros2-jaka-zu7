<?xml version="1.0"?>
<!--
  JAKA ZU7 Camera Configuration for Gazebo Sim (Fortress)
  Support for multiple camera types and mounting positions

  Usage in robot URDF xacro:
    <xacro:include filename="$(find jaka_vision)/urdf/inc/jaka_camera_gazebo.xacro" />

    OR with custom parameters:
    <xacro:jaka_camera_gazebo
        parent="Link_6"
        camera_type="realsense"
        offset_x="0.0" offset_y="0.0" offset_z="0.05"
        offset_roll="0.0" offset_pitch="0.0" offset_yaw="0.0" />

  Parameters:
    parent          - Parent link to attach camera (default: Link_6)
    camera_type     - Camera model: realsense_d435 / kinect / generic (default: generic)
    offset_x/y/z    - Position offset from parent link (default: 0.0 0.0 0.05)
    offset_roll/pitch/yaw - Rotation offset in radians (default: 0 0 0)
    joint_type      - Joint type: fixed / floating / revolute (default: fixed)
    camera_name     - Camera namespace (default: camera)
    update_rate     - Camera update rate Hz (default: 30.0)
    image_width     - Image width pixels (default: 640)
    image_height    - Image height pixels (default: 480)
    update_rate     - Sensor update rate (default: 30.0)
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro"
       xmlns:gazebo="http://gazebosim.org">

    <!-- Camera type definitions -->
    <xacro:property name="REALSENSE_D435" value="realsense_d435" />
    <xacro:property name="KINECT" value="kinect" />
    <xacro:property name="GENERIC" value="generic" />

    <xacro:macro name="jaka_camera_gazebo" params="parent:=Link_6
                                                  camera_type:=generic
                                                  offset_x:=0.0 offset_y:=0.0 offset_z:=0.05
                                                  offset_roll:=0.0 offset_pitch:=0.0 offset_yaw:=0.0
                                                  joint_type:=fixed
                                                  camera_name:=camera
                                                  update_rate:=30.0
                                                  image_width:=640
                                                  image_height:=480">

        <!-- Calculate camera visual dimensions based on type -->
        <xacro:property name="camera_box_size"
                       value="${'0.025 0.09 0.025' if camera_type == REALSENSE_D435 else ('0.06 0.18 0.07' if camera_type == KINECT else '0.02 0.02 0.02')}" />
        <xacro:property name="camera_box_color"
                       value="${'0.3 0.3 0.3 1.0' if camera_type == REALSENSE_D435 else ('0.2 0.4 0.6 1.0' if camera_type == KINECT else '0.1 0.1 0.1 1.0')}" />

        <!-- Camera optical frame link (ROS convention: -90deg roll) -->
        <link name="${camera_name}_link_optical">
        </link>

        <!-- Camera physical link -->
        <link name="${camera_name}_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.01" />
                <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${camera_box_size}" />
                </geometry>
                <material name="${camera_name}_black">
                    <color rgba="${camera_box_color}" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${camera_box_size}" />
                </geometry>
            </collision>
        </link>

        <!-- Joint to parent (end-effector) - configurable type -->
        <joint name="${camera_name}_joint" type="${joint_type}">
            <origin xyz="${offset_x} ${offset_y} ${offset_z}" rpy="${offset_roll} ${offset_pitch} ${offset_yaw}" />
            <parent link="${parent}" />
            <child link="${camera_name}_link" />
            <!-- Only add dynamics for non-fixed joints -->
            <xacro:if value="${joint_type != 'fixed'}">
                <dynamics damping="0.1" friction="0.1" />
            </xacro:if>
        </joint>

        <!-- Optical frame joint for ROS convention (ROS uses: X=forward, Y=left, Z=up) -->
        <!-- Gazebo camera: X=right, Y=down, Z=forward -->
        <!-- Transform: Roll=-90deg, Pitch=0, Yaw=-90deg -->
        <joint name="${camera_name}_optical_joint" type="fixed">
            <origin xyz="0.0 0.0 0.0" rpy="-1.5707 0 -1.5707"/>
            <parent link="${camera_name}_link"/>
            <child link="${camera_name}_link_optical"/>
        </joint>

        <!-- Gazebo sensor configuration -->
        <gazebo reference="${camera_name}_link">
            <sensor name="${camera_name}_sensor" type="camera">
                <always_on>true</always_on>
                <update_rate>${update_rate}</update_rate>
                <visualize>true</visualize>
                <camera>
                    <!-- FOV based on camera type -->
                    <horizontal_fov>${'1.396' if camera_type == REALSENSE_D435 else ('1.047' if camera_type == KINECT else '1.047')}</horizontal_fov>
                    <image>
                        <width>${image_width}</width>
                        <height>${image_height}</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>${'0.1' if camera_type == REALSENSE_D435 else ('0.5' if camera_type == KINECT else '0.05')}</near>
                        <far>${'10.0' if camera_type == REALSENSE_D435 else ('10.0' if camera_type == KINECT else '10.0')}</far>
                    </clip>
                    <!-- Distortion for Kinect -->
                    <xacro:if value="${camera_type == KINECT}">
                        <distortion>
                            <k1>0.0</k1>
                            <k2>0.0</k2>
                            <k3>0.0</k3>
                            <p1>0.0</p1>
                            <p2>0.0</p2>
                            <cx>0.0</cx>
                            <cy>0.0</cy>
                        </distortion>
                    </xacro:if>
                </camera>
                <topic>${camera_name}/image_raw</topic>
            </sensor>
        </gazebo>

    </xacro:macro>

    <!-- Convenience macro: Realsense D435 (common eye-in-hand camera) -->
    <xacro:macro name="jaka_camera_realsense" params="parent:=Link_6 offset_x:=0.0 offset_y:=0.0 offset_z:=0.02">
        <xacro:jaka_camera_gazebo
            parent="${parent}"
            camera_type="realsense_d435"
            offset_x="${offset_x}" offset_y="${offset_y}" offset_z="${offset_z}"
            offset_roll="0.0" offset_pitch="0.0" offset_yaw="0.0"
            joint_type="fixed"
            camera_name="camera"
            update_rate="30.0"
            image_width="640"
            image_height="480" />
    </xacro:macro>

    <!-- Convenience macro: Kinect (external/mounted camera) -->
    <xacro:macro name="jaka_camera_kinect" params="parent:=world offset_x:=0.5 offset_y:=0.0 offset_z:=1.0">
        <xacro:jaka_camera_gazebo
            parent="${parent}"
            camera_type="kinect"
            offset_x="${offset_x}" offset_y="${offset_y}" offset_z="${offset_z}"
            offset_roll="0.0" offset_pitch="0.0" offset_yaw="0.0"
            joint_type="fixed"
            camera_name="camera"
            update_rate="30.0"
            image_width="640"
            image_height="480" />
    </xacro:macro>

</robot>
