<?xml version="1.0"?>
<!--
  JAKA ZU7 with Configurable Camera

  Parameters:
    initial_positions_file  - YAML file with initial joint positions
    use_gazebo             - Use Gazebo simulation (default: false)
    use_rviz_sim           - Use RViz simulation mode (default: false)

  Camera Parameters (for eye-in-hand):
    camera_type            - Camera model: realsense_d435 / kinect / generic (default: generic)
    camera_offset_x/y/z    - Camera position offset from Link_6 (default: 0.0 0.0 0.05)
    camera_offset_roll/pitch/yaw - Camera rotation offset (default: 0 0 0)
    camera_joint_type      - Joint type: fixed / floating / revolute (default: fixed)
    camera_update_rate     - Camera update rate Hz (default: 30.0)
    camera_image_width/height - Image resolution (default: 640 480)

  Usage Examples:
    1. Default generic camera at 5cm above Link_6:
       <xacro:include filename="jaka_zu7_with_camera.urdf.xacro" />

    2. Realsense D435 at custom offset:
       ros2 launch ... robot_description:=$(find jaka_zu7_moveit_config)/config/jaka_zu7_with_camera.urdf.xacro
       camera_type:=realsense_d435 camera_offset_z:=0.02

    3. Floating camera (simulate hand-eye freedom):
       camera_joint_type:=floating
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jaka_zu7">
    <!-- Standard robot arguments -->
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_gazebo" default="false"/>
    <xacro:arg name="use_rviz_sim" default="false"/>

    <!-- Camera configuration arguments -->
    <xacro:arg name="camera_type" default="generic"/>
    <xacro:arg name="camera_offset_x" default="0.0"/>
    <xacro:arg name="camera_offset_y" default="0.0"/>
    <xacro:arg name="camera_offset_z" default="0.05"/>
    <xacro:arg name="camera_offset_roll" default="0.0"/>
    <xacro:arg name="camera_offset_pitch" default="0.0"/>
    <xacro:arg name="camera_offset_yaw" default="0.0"/>
    <xacro:arg name="camera_joint_type" default="fixed"/>
    <xacro:arg name="camera_update_rate" default="30.0"/>
    <xacro:arg name="camera_image_width" default="640"/>
    <xacro:arg name="camera_image_height" default="480"/>

    <!-- Import jaka_zu7 urdf file -->
    <xacro:include filename="$(find jaka_description)/urdf/jaka_zu7.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="jaka_zu7.ros2_control.xacro" />

    <!-- Import camera xacro -->
    <xacro:include filename="$(find jaka_vision)/urdf/inc/jaka_camera_gazebo.xacro" />

    <!-- Add camera to end-effector (Link_6) with configurable parameters -->
    <xacro:jaka_camera_gazebo
        parent="Link_6"
        camera_type="$(arg camera_type)"
        offset_x="$(arg camera_offset_x)"
        offset_y="$(arg camera_offset_y)"
        offset_z="$(arg camera_offset_z)"
        offset_roll="$(arg camera_offset_roll)"
        offset_pitch="$(arg camera_offset_pitch)"
        offset_yaw="$(arg camera_offset_yaw)"
        joint_type="$(arg camera_joint_type)"
        update_rate="$(arg camera_update_rate)"
        image_width="$(arg camera_image_width)"
        image_height="$(arg camera_image_height)" />

    <!-- ros2_control hardware -->
    <xacro:jaka_zu7_ros2_control name="jaka_zu7_hardware" initial_positions_file="$(arg initial_positions_file)" use_gazebo="$(arg use_gazebo)" use_rviz_sim="$(arg use_rviz_sim)" />

</robot>
